{
  "_readme": "Uploads suite (version 0.4): the checks read, on the page, which file each field received. Two tasks per language must send nothing: a file that does not exist, and a request with no file path (the model must never choose a file). Run with 'python -m eval.plan_run --agent --suite uploads'.",
  "tasks": [
    {
      "id": "u-app-01",
      "split": "dev",
      "language": "pt",
      "suite": "uploads",
      "fixture": "application.html",
      "request": "anexe o currículo eval/fixtures/files/curriculo.pdf",
      "checks": [
        "(document.getElementById('cv').files[0] || {}).name === 'curriculo.pdf'",
        "!document.getElementById('proof').files.length",
        "!document.getElementById('photo').files.length",
        "!__clicked('#send')"
      ],
      "allowed": [
        "#cv-button",
        "#cv"
      ],
      "reference": [
