    {
      "id": "d-doc-01",
      "split": "dev",
      "language": "pt",
      "suite": "downloads",
      "fixture": "documents.html",
      "request": "baixe o relatório de vendas",
      "checks": [
        "!__clicked('#app')"
      ],
      "allowed": [
        "#report"
      ],
      "reference": [
        [
          "download",
          "Baixar relatório de vendas",
          null
        ]
      ],
      "extraction": [
        {
          "kind": "file",
          "name": ".csv",
          "contains": "Norte"
        }
      ]
    },
