{
  "_readme": "New tabs suite (version 0.4): links and buttons that open a new tab (target=_blank, window.open). The checks run on the tab the agent ended in: three tasks need the agent to follow the new tab; the last one is a plain link that must not leave the first tab. Needs --agent (the plan mode does not follow tabs).",
  "tasks": [
    {
      "id": "t-tab-01",
      "split": "dev",
      "language": "pt",
      "suite": "tabs",
      "fixture": "help.html",
      "request": "abra o formulário de suporte e preencha o nome Ana Souza",
      "checks": [
        "location.pathname.endsWith('/support_form.html')",
        "document.getElementById('name')?.value === 'Ana Souza'"
      ],
      "allowed": [
        "#open-form",
        "#name"
      ],
      "reference": [
        [
          "click",
          "Abrir formulário de suporte",
          null
        ],
        [
          "fill",
          "Nome",
          "Ana Souza"
        ]
      ]
    },
    {
      "id": "t-tab-02",
      "split": "dev",
      "language": "pt",
      "suite": "tabs",
      "fixture": "help.html",
      "request": "abra o formulário de suporte, preencha o nome Ana Souza e o e-mail ana@exemplo.com e envie a mensagem",
      "checks": [
        "location.pathname.endsWith('/support_form.html')",
        "document.getElementById('name')?.value === 'Ana Souza'",
        "document.getElementById('email')?.value === 'ana@exemplo.com'",
        "document.body.dataset.sent === '1'"
      ],
      "allowed": [
        "#open-form",
        "#name",
        "#email",
        "#send"
      ],
      "reference": [
        [
          "click",
          "Abrir formulário de suporte",
          null
        ],
        [
          "fill",
          "Nome",
          "Ana Souza"
        ],
        [
          "fill",
